{
  "name": "sadran",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sadran — shift scheduling platform (MVP)",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/app.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web install && npm --prefix web run build && prisma generate",
    "start": "prisma migrate deploy && tsx server/src/app.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "bootstrap:admin": "tsx prisma/bootstrap-admin.ts",
    "setup": "npm install && npm --prefix web install && prisma generate && prisma migrate deploy && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^9.1.3",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.2.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
