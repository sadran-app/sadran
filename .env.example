# Copy to .env and fill in. Required for both local dev and production.

# Postgres connection string. Locally you can use a free managed DB (Neon /
# Supabase) or a local Postgres. In production your host provides this.
DATABASE_URL="postgresql://user:password@host:5432/sadran?sslmode=require"

# HTTP port the server listens on.
PORT=3001

# 'development' or 'production'. In production the server also serves the built
# web app and refuses to start with the default JWT secret.
NODE_ENV=development

# Secret used to sign login tokens. MUST be a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# Platform admin bootstrap (used by `npm run bootstrap:admin`).
ADMIN_EMAIL="you@yourdomain.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="מנהל-על"
